# Copy to .env and adjust as needed.

# PostgreSQL connection string.
# Matches docker-compose.yml below. If you use a local Postgres instead, point this at it.
DATABASE_URL="postgresql://nestwise:nestwise@localhost:5432/nestwise?schema=public"
# Direct (non-pooled) connection for `prisma migrate` / `prisma db push`.
# Locally: same as DATABASE_URL. On a pooled host (e.g. Neon): the non-pooled string.
DIRECT_URL="postgresql://nestwise:nestwise@localhost:5432/nestwise?schema=public"

# Auth.js (NextAuth v5) session encryption secret.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-secret-change-me-0000000000000000000000="
NEXTAUTH_URL="http://localhost:3000"

# --- Optional / future ---
# When set, Ask NestWise calls the OpenAI API to phrase its (retrieval-grounded) answers.
# Leave empty to use the deterministic rule-based composer. Needs API credit at
# platform.openai.com/billing — a ChatGPT Plus/Pro subscription does NOT include API access.
OPENAI_API_KEY=""
# Optional model override (default: gpt-4o-mini). e.g. gpt-4o for higher quality.
OPENAI_MODEL=""

# Where uploaded milestone-journal media is stored on disk (local dev adapter).
NESTWISE_MEDIA_DIR=".media"
