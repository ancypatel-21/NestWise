# Copy to .env and adjust as needed.

# PostgreSQL connection string.
# Matches docker-compose.yml below. If you use a local Postgres instead, point this at it.
DATABASE_URL="postgresql://nestwise:nestwise@localhost:5432/nestwise?schema=public"

# Auth.js (NextAuth v5) session encryption secret.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-secret-change-me-0000000000000000000000="
NEXTAUTH_URL="http://localhost:3000"

# --- Optional / future ---
# When set, Ask NestWise can call a real LLM (see src/lib/ai/llm.ts). Leave empty to use the
# deterministic rule-based composer.
ANTHROPIC_API_KEY=""

# Where uploaded milestone-journal media is stored on disk (local dev adapter).
NESTWISE_MEDIA_DIR=".media"
